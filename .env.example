# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Realtime Database URL (required for collaborative features)
# Get this from Firebase Console > Realtime Database > Copy database URL
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://console.firebase.google.com/u/0/project/gaurav-personal-notes/database/gaurav-personal-notes-default-rtdb/data/~2F

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual Firebase config
# 3. Enable Realtime Database in Firebase Console for collaborative features
# 4. Never commit .env.local to version control